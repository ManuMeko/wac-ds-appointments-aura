# Copia este archivo a deploy/.env y rellena los valores.
# deploy/.env no se versiona. No pongas secretos reales aquí.

# Dominios públicos. Registros A o AAAA hacia el VPS, sin esquema.
AURA_DOMAIN=aura.example.com
TALLER_DOMAIN=taller.example.com
API_DOMAIN=api.example.com

# Correo de la cuenta ACME de Caddy. No es el remitente de Resend.
ACME_EMAIL=ops@example.com

# PostgreSQL. El puerto 5432 no se publica.
POSTGRES_DB=wac_ds_appointments
POSTGRES_USER=wacds
POSTGRES_PASSWORD=

# Secreto HMAC de los JWT. Obligatorio en el perfil prod.
# Generar en el VPS: openssl rand -base64 48
# La API no arranca si falta, si tiene menos de 32 bytes,
# si repite el valor de desarrollo del repositorio o si es poco variado.
JWT_SECRET=
JWT_ISSUER=wac-ds-appointments

# Orígenes del navegador, separados por comas, sin barra final.
APP_SECURITY_CORS_ALLOWED_ORIGINS=https://aura.example.com,https://taller.example.com

# Bootstrap del OWNER de desarrollo. En prod tiene que ser false.
# Si vale true, el perfil prod aborta el arranque.
APP_BOOTSTRAP_DEV_OWNER_ENABLED=false

# Ventana fija en memoria, por IP, solo en el perfil prod.
APP_SECURITY_RATE_LIMIT_ENABLED=true
APP_SECURITY_RATE_LIMIT_LOGIN_PER_MINUTE=10
APP_SECURITY_RATE_LIMIT_PUBLIC_BOOKING_PER_MINUTE=10
APP_SECURITY_RATE_LIMIT_WINDOW_SECONDS=60

# Enlaces de los emails de reserva. Un solo origen: la API no distingue
# el dominio de Aura del de Taller al construir el enlace.
PUBLIC_FRONTEND_BASE_URL=https://aura.example.com
PUBLIC_BOOKING_CONFIRMATION_EMAIL_ENABLED=true

# Resend. real-delivery queda en false hasta verificar el dominio.
# El scheduler queda en false para no consumir recordatorios
# mientras no haya proveedor: el simulador de desarrollo no carga con el perfil prod.
RESEND_API_KEY=
RESEND_FROM_EMAIL=reservas@example.com
RESEND_FROM_NAME=WAC D.S. Appointments
RESEND_REPLY_TO=
REMINDER_EMAIL_REAL_DELIVERY_ENABLED=false
REMINDER_SCHEDULER_ENABLED=false

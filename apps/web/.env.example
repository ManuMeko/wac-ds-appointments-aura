# ============================================================
# WAC DS · MODEL 01 · APPOINTMENTS
# Environment variables template
# ============================================================

# Public URL where the application is deployed.
#
# Local development:
# http://localhost:3000
#
# Production example:
# https://aura-studio-demo.vercel.app

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo de contenido y tema: aura | taller.
# aura es el valor por defecto. taller carga Motorline.
# Hay que reiniciar `next dev` al cambiarla.
NEXT_PUBLIC_DEMO=aura

# Public slug of the business served by this deployment.
# The booking page and the panel send it to the API.
# Sobrescribe solo el slug; el contenido lo elige NEXT_PUBLIC_DEMO.
# Aura Studio demo:
NEXT_PUBLIC_BUSINESS_SLUG=aura-studio

# Public base URL of the appointments API.
#
# Local development:
# http://localhost:8080

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
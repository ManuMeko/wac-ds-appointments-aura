# ============================================================
# WAC DS · MODEL 01 · APPOINTMENTS
# Environment variables template
# ============================================================

# Demo que se hornea en el export estático.
# aura (por defecto) | taller
#
# Un build publica una sola demo. Para las dos,
# ejecuta el build dos veces cambiando este valor.

NEXT_PUBLIC_DEMO=aura

# Public URL where the application is deployed.
#
# Local development:
# http://localhost:3000
#
# Production example:
# https://aura-studio-demo.pages.dev

NEXT_PUBLIC_SITE_URL=http://localhost:3000
